# gyn64.fr : hébergement OVH (Apache)

Options -Indexes
AddDefaultCharset UTF-8
AddType image/webp .webp
AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest

ErrorDocument 404 /404.html

# --- Redirections : tout vers https://gyn64.fr (sans www) ----------------
RewriteEngine On
# Sur OVH, le port indique le protocole (80 = http).
RewriteCond %{HTTP_HOST} ^www\. [NC,OR]
RewriteCond %{SERVER_PORT} ^80$
RewriteRule ^(.*)$ https://gyn64.fr/$1 [R=301,L]

# /index.html → /
RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
RewriteRule ^index\.html$ / [R=301,L]

# Fichiers de travail, jamais servis s’ils ont été envoyés par erreur
RewriteRule ^(tools/|README\.md|PROMPT_CLAUDE_CODE\.md) - [R=404,L]

# --- En-têtes ------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # Si Plausible est ajouté un jour : ajouter https://plausible.io à script-src et connect-src.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; media-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
  # À activer une fois le certificat SSL confirmé (voir README) :
  # Header always set Strict-Transport-Security "max-age=31536000"

  # HTML, CSS, JS : toujours revalidés (réponse 304 si inchangés)
  <FilesMatch "\.(html|css|js|webmanifest|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Icônes à la racine : une semaine
  <FilesMatch "^(favicon.*|apple-touch-icon|icon-\d+)\.(png|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# --- Compression ---------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json application/ld+json application/manifest+json image/svg+xml
</IfModule>
